{
    "name": "capell-app/translation-manager",
    "description": "File-based Capell translation editing with side-by-side locale comparison, missing and stale key checks, safe override writes, and optional reviewed AI drafting.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\TranslationManager\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\TranslationManager\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\TranslationManager\\Providers\\TranslationManagerServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "suggest": {
        "capell-app/ai-orchestrator": "Enable optional reviewed AI translation drafts.",
        "capell-app/seo-suite": "Pair translation coverage with SEO and AI-discovery workflows."
    },
    "homepage": "https://github.com/capell-app/translation-manager",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "translations"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/translation-manager"
    }
}
